{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lernkiste",
  "mainBinaryName": "Lernkiste",
  "version": "0.0.1",
  "identifier": "de.lernkiste.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Lernkiste",
    "shortDescription": "Lernseiten üben, Fortschritt behalten",
    "longDescription": "Die Lernkiste zeigt interaktive Lernseiten an und merkt sich den Lernstand.",
    "copyright": "Lernkiste",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RTgxOEVCMzBBNDc1QjYKUldTMmRhUXc2eGpvTndoRWFsMCtkVlNKQVpDVG9GemlNZGMzb29GWVlrc3M5WC9Ga01PNjZIcS8K",
      "endpoints": [
        "https://github.com/Wvnderkind/lernkiste/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
